{
  "name": "v-image",
  "version": "4.0.3",
  "private": false,
  "description": "Vue 3 file input component with image preview, drag-and-drop upload, and reactive validation. TypeScript-native ESM.",
  "keywords": [
    "image",
    "input-image",
    "vue3",
    "vuejs"
  ],
  "homepage": "https://v-image.vinayakkulkarni.dev",
  "bugs": {
    "url": "https://github.com/vinayakkulkarni/v-image/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Vinayak Kulkarni",
    "email": "inbox.vinayak@gmail.com",
    "url": "https://vinayakkulkarni.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinayakkulkarni/v-image.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && pnpm --filter ./example run typecheck",
    "test": "vp test run",
    "build": "vp pack",
    "build:demo": "pnpm run build && pnpm --filter ./example run build",
    "deploy": "pnpm run build:demo && pnpm --filter ./example run deploy",
    "prepare": "is-ci || husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^26.6.5",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "lint-staged": "^17.6.0",
    "typescript": "^6.0.3",
    "unplugin-vue": "^8.0.0",
    "vite-plus": "^1.4.0",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "peerDependencies": {
    "vue": "^3.5.27"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.x"
    }
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
